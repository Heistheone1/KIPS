# KIPS-SMS Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

NODE_ENV=development
PORT=5001

# PostgreSQL connection string � local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kips_sms

# JWT — use a long random secret (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# Cookie signing secret — use a long random secret (min 32 chars)
COOKIE_SECRET=replace_with_a_long_random_cookie_secret

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# bcrypt rounds (10-12 recommended)
BCRYPT_ROUNDS=12

# Seed variables — only needed when running utils/seedAdmin.js
SEED_SCHOOL_NAME=KIPS School
SEED_SCHOOL_CODE=KIPS
SEED_SCHOOL_EMAIL=admin@kipsschool.ac
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_EMAIL=admin@kipsschool.ac
SEED_ADMIN_PASSWORD=replace_with_strong_password
